PORT=4000
HOST=0.0.0.0

# URLs - REQUIRED for production - All must be full URLs with protocol
# APP_URL: Frontend/Web application URL
#   - Used in: Email verification redirects, team member portal links, email templates
#   - Example: https://sewa-innovation-challenge.wb.gov.in
#   - MUST be set for production (application will error if missing)
APP_URL=http://localhost:3000

# API_BASE_URL: Backend/API server URL
#   - Used in: Email verification links, API client references
#   - Example: https://api.sewa-innovation-challenge.wb.gov.in
#   - MUST be set for production (application will error if missing)
API_BASE_URL=http://localhost:4000

# CORS_ORIGINS: Comma-separated list of allowed frontend origins
#   - Used in: CORS validation for API requests
#   - If not set, defaults to localhost origins (development)
#   - Example: https://sewa-innovation-challenge.wb.gov.in,https://www.sewa-innovation-challenge.wb.gov.in
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inno_challenge
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# Storage
LOCAL_STORAGE_DIR=./uploads

# SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
MAIL_FROM_NAME=Sewa First Innovation Challenge
MAIL_FROM_EMAIL=noreply@example.com

# Email Verification
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440

# Contact Email Addresses (Optional - currently in content files)
# These are displayed in the application for user inquiries
CONTACT_EMAIL_GENERAL=wbdstbt@gmail.com
CONTACT_EMAIL_PRIVACY=privacy@innovation-challenge.gov.in
CONTACT_EMAIL_IP=ip@innovation-challenge.gov.in
CONTACT_EMAIL_ACCESSIBILITY=accessibility@innovation-challenge.gov.in
