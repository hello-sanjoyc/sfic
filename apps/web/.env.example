# Application Metadata
NEXT_PUBLIC_APP_NAME="The National Innovation Challenge"
NEXT_PUBLIC_APP_SHORT_NAME="The National Innovation Challenge"
NEXT_PUBLIC_APP_SLOGAN="Science, technology and innovation for public impact."

# URLs - REQUIRED for production - All must be full URLs with protocol
# Used for: OG images, social sharing, email links, redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used for: API client requests, email verification links
NEXT_PUBLIC_API_URL=http://localhost:4000
# Used for: CMS integration (optional)
NEXT_PUBLIC_CMS_URL=http://localhost:1337

# Application Domain (used by some authentication libraries)
NEXT_PUBLIC_APP_DOMAIN=localhost

# File Upload Configuration
NEXT_PUBLIC_SUPPORTING_DOCUMENT_MAX_FILES=3
NEXT_PUBLIC_SUPPORTING_DOCUMENT_MAX_SIZE_MB=2

# Production URLs Example:
# NEXT_PUBLIC_APP_URL=https://sewa-innovation-challenge.wb.gov.in
# NEXT_PUBLIC_API_URL=https://api.sewa-innovation-challenge.wb.gov.in
# NEXT_PUBLIC_CMS_URL=https://cms.sewa-innovation-challenge.wb.gov.in
# NEXT_PUBLIC_APP_DOMAIN=sewa-innovation-challenge.wb.gov.in
