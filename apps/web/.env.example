# Application Metadata
NEXT_PUBLIC_APP_NAME="Seva First Innovation Challenge - Eastern Region"
NEXT_PUBLIC_APP_SHORT_NAME="Seva First Innovation Challenge - Eastern Region"
NEXT_PUBLIC_APP_SLOGAN="Science, technology and innovation for public impact."

# URLs - REQUIRED for production - All must be full URLs with protocol
# Used for: OG images, social sharing, email links, redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost

# Used for: API client requests
NEXT_PUBLIC_API_URL=http://localhost:4000

# Used for: CMS integration (optional)
NEXT_PUBLIC_CMS_URL=http://localhost:1337

# Application Domain (used by some authentication libraries)
NEXT_PUBLIC_APP_DOMAIN=localhost

# File Upload Configuration
NEXT_PUBLIC_SUPPORTING_DOCUMENT_MAX_FILES=3
NEXT_PUBLIC_SUPPORTING_DOCUMENT_MAX_SIZE_MB=5

# Email Verification
NEXT_PUBLIC_EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=10
NEXT_PUBLIC_EMAIL_VERIFICATION_RESEND_INTERVAL_MINUTES=10

# Challenge Dates
NEXT_PUBLIC_CHALLENGE_START_DATE=2026-09-19
NEXT_PUBLIC_LAST_DATE_OF_SUBMISSION=2026-10-30
