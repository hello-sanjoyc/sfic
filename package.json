{
    "name": "SewaFirstInnovationChallenge",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@10.20.0",
    "scripts": {
        "dev:web": "pnpm --filter @SewaFirstInnovationChallenge/web dev",
